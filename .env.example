# Backend origin the browser calls, inlined at build time (Vite, VITE_ prefix).
# Local dev: point at the Flask server. Production: leave empty to use the
# Netlify /api proxy, or set it to the backend URL to call it directly.
VITE_BASE_URL=http://127.0.0.1:3001

# Build-time only (never reaches the browser). Set in the Netlify UI to make
# Netlify proxy /api/* to the backend. Not used for local dev.
# API_PROXY_TARGET=https://your-backend.up.railway.app
