# Backend origin the browser calls, inlined at build time (Vite, VITE_ prefix).
# Local dev: point at the Flask server.
# Production: left empty in .env.production so the app calls /api/... on its own
# origin, which netlify.toml proxies to the backend. Nothing to set in Netlify.
VITE_BASE_URL=http://127.0.0.1:3001
